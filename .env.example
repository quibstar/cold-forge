# Copy to .env on the server and fill in. .env is gitignored — never commit it.

# The hostname this is served at. It appears in every tracked link, unsubscribe
# and survey URL inside outgoing mail, so it outlives any single deploy: getting
# it wrong means dead links in inboxes you cannot reach.
PHX_HOST=go.affordablestartup.com

# mix phx.gen.secret
SECRET_KEY_BASE=

POSTGRES_USER=cold_forge
POSTGRES_PASSWORD=
POSTGRES_DB=cold_forge

# The secret in the inbound webhook path, /inbound/<token>. Without it that
# endpoint refuses everything, so replies stop being detected — it fails closed
# rather than open. Generate with: openssl rand -hex 32
INBOUND_TOKEN=

# An IAM user with ses:SendRawEmail and nothing else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
