<.unsub_shell title="Link not recognized">
  <p class="text-base-content/70">
    This link isn't valid — it may have already been used, or the message it
    came from may have been deleted.
  </p>
  <p class="mt-3 text-base-content/70">
    If you meant to reply, just reply to the email directly.
  </p>
</.unsub_shell>
