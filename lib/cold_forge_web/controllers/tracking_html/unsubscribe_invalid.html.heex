<.unsub_shell title="Link not recognized">
  <p class="text-base-content/70">
    This unsubscribe link isn't valid — it may have already been used, or the
    message it came from may have been deleted.
  </p>
  <p class="mt-3 text-base-content/70">
    If you're still getting email you don't want, reply to any of it and you'll
    be removed by hand.
  </p>
</.unsub_shell>
