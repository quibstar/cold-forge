<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Flyers · Cold Forge</title>
    <%!-- ExteriorPro's own faces, from its brand kit: Instrument Sans for the
    wordmark, headline and body, IBM Plex Mono for the flyer's code. Loaded
    here rather than in app.css because this page is printed, not browsed, and
    nothing else in Cold Forge uses them. `display=block` so a print started
    the moment the page opens doesn't go out in the fallback face. --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wdth,wght@75..100,400..700&family=IBM+Plex+Mono:wght@500&display=block"
    />
    <%!-- A standalone page with its own stylesheet: it's printed, not browsed,
    and the app's layout and CSS would only fight the Letter sheet. --%>
    <style>
      /* Letter, edge to edge. The design sits a quarter inch in from every
         edge, so an office printer — which can't reach the last few
         millimetres — prints all of it, and a print shop can still trim it. */
      @page { size: letter portrait; margin: 0; }

      :root {
        /* The brand kit's colours. Deep teal for anything printed on white:
           primary teal washes out on toner. Light teal only on the dark band,
           where the kit says to use it. */
        --ink: #0F172A;
        --teal: #0F766E;
        --teal-bright: #14B8A6;
        --teal-light: #5EEAD4;
        --muted: #475569;
        --on-dark: #CBD5E1;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Instrument Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
        color: var(--ink);
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      .sheet {
        width: 8.5in;
        height: 11in;
        padding: 0.25in;
        page-break-after: always;
        background: #fff;
        overflow: hidden;
      }
      .sheet:last-child { page-break-after: auto; }

      .page {
        height: 100%;
        display: flex;
        flex-direction: column;
      }

      /* Header: who it's from on the left, where to find them on the right —
         the strip a contractor's eye lands on after the photo. */
      .head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.24in 0.35in 0.2in;
      }
      .lockup { height: 0.5in; width: auto; display: block; }
      .contact-url { font-size: 15pt; font-weight: 700; color: var(--teal); }

      /* The photo and the pitch side by side: a person in the shirt, in front
         of the kind of house they work on, next to what she's holding it for. */
      .hero {
        flex: 1;
        display: grid;
        grid-template-columns: 3.55in 1fr;
        min-height: 0;
      }
      .photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 18%;
        display: block;
      }
      .pitch {
        padding: 0.1in 0.35in 0.2in 0.4in;
        display: flex;
        flex-direction: column;
      }
      .eyebrow {
        margin: 0;
        font-size: 12.5pt;
        font-weight: 600;
        color: var(--teal);
      }
      h1 {
        margin: 0.08in 0 0;
        font-size: 40pt;
        font-stretch: 75%;
        font-variation-settings: "wdth" 75;
        font-weight: 700;
        line-height: 0.95;
        text-transform: uppercase;
        letter-spacing: 0.005em;
      }
      /* The turn in the sentence — what it isn't — in teal. */
      h1 .turn { color: var(--teal); }

      .lede {
        margin: 0.14in 0 0;
        font-size: 12pt;
        line-height: 1.45;
        color: var(--muted);
      }

      .checks { margin: 0.14in 0 0; padding: 0; list-style: none; }
      .checks li {
        display: grid;
        grid-template-columns: 0.3in 1fr;
        gap: 0.1in;
        align-items: start;
        padding: 0.065in 0;
        border-top: 1px solid #E2E8F0;
      }
      .checks li:first-child { border-top: 0; }
      .check { width: 0.3in; height: 0.3in; display: block; }
      .check-name { margin: 0.02in 0 0; font-size: 12.5pt; font-weight: 700; line-height: 1.2; }
      .check-detail { margin: 0.03in 0 0; font-size: 10pt; line-height: 1.35; color: var(--muted); }

      /* Short claims that aren't a step in the job, as solid badges — they're
         read at a glance, not as sentences. */
      .highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 0.08in;
        margin: 0.12in 0 0;
        padding: 0;
        list-style: none;
      }
      .highlights li {
        display: flex;
        align-items: center;
        gap: 0.07in;
        padding: 0.06in 0.13in 0.06in 0.09in;
        border-radius: 999px;
        background: var(--ink);
        color: #fff;
        font-size: 10.5pt;
        font-weight: 700;
        white-space: nowrap;
      }
      .highlights svg { width: 0.15in; height: 0.15in; flex: none; }

      /* The trades, as a band: the one line that tells a roofer from across
         the room that this is for them. */
      .band {
        background: var(--teal);
        color: #fff;
        text-align: center;
        padding: 0.16in 0.3in;
        font-size: 14pt;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      /* The offer and the code to claim it, on slate. White card behind the
         QR, because a code scans on contrast, not on colour. In the bottom
         third, so a letter fold doesn't crease it. */
      .offer {
        background: var(--ink);
        color: #fff;
        padding: 0.26in 0.4in 0.18in;
      }
      .offer-row {
        display: flex;
        align-items: center;
        gap: 0.4in;
      }
      .qr-card {
        flex: 0 0 auto;
        background: #fff;
        border-radius: 0.14in;
        padding: 0.12in;
      }
      .qr { width: 1.75in; height: 1.75in; display: block; }
      .scan-lead {
        margin: 0;
        font-size: 30pt;
        font-weight: 700;
        font-stretch: 85%;
        font-variation-settings: "wdth" 85;
        line-height: 1.02;
      }
      .scan-url { margin: 0.1in 0 0; font-size: 20pt; font-weight: 700; color: var(--teal-light); }
      .scan-terms { margin: 0.08in 0 0; font-size: 13pt; color: var(--on-dark); }

      .foot {
        margin: 0.18in 0 0;
        padding-top: 0.12in;
        border-top: 1px solid #334155;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.3in;
        font-size: 9pt;
        color: #94A3B8;
      }
      /* Which flyer this is, small enough that only the person holding the
         stack reads it — it's for sorting, not for the contractor. */
      .code {
        font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace;
        font-size: 7.5pt;
        white-space: nowrap;
      }

      /* On screen only: the two print settings that ruin a flyer. */
      .how {
        padding: 24px;
        font-family: -apple-system, system-ui, sans-serif;
        font-size: 14px;
        color: #374151;
        background: #f3f4f6;
      }
      .how kbd { background: #fff; border: 1px solid #d1d5db; border-radius: 4px; padding: 1px 5px; }
      @media screen {
        body { background: #e5e7eb; }
        .sheet { margin: 24px auto; box-shadow: 0 1px 6px rgb(15 23 42 / 0.18); }
      }
      @media print { .how { display: none; } }
    </style>
  </head>
  <body>
    <div class="how">
      <%= cond do %>
        <% @sheets == [] -> %>
          <strong>No flyers selected.</strong> Go back and tick the places to print for.
        <% @preview? -> %>
          <strong>Preview.</strong>
          This is exactly how it prints, QR code and all. To print it, <kbd>⌘P</kbd>
          at <b>100% scale</b>
          with <b>headers and footers off</b>.
        <% true -> %>
          <strong>{length(@sheets)} {if length(@sheets) == 1, do: "flyer", else: "flyers"} ready.</strong>
          Print at <b>100% scale</b>
          with <b>headers and footers off</b>, or the QR shrinks and
          the browser writes a URL across the bottom of your flyer. <kbd>⌘P</kbd>
      <% end %>
    </div>

    <section :for={sheet <- @sheets} class="sheet" id={"flyer-#{sheet.placement.code}"}>
      <div class="page">
        <header class="head">
          <.lockup class="lockup" />
          <div class="contact-url">{@display_url}</div>
        </header>

        <div class="hero">
          <img
            class="photo"
            src={~p"/images/flyers/exteriorpro-avatar.webp"}
            alt="An ExteriorPro rep with a tablet outside a finished home"
          />

          <div class="pitch">
            <p :if={sheet.eyebrow} class="eyebrow">{sheet.eyebrow}</p>

            <h1>
              <%= for {line, i} <- Enum.with_index(ColdForge.Flyers.Content.headline_lines(@content)) do %>
                <span class={i > 0 && "turn"}>{line}</span><br :if={i == 0} />
              <% end %>
            </h1>

            <p :if={@content.lede not in [nil, ""]} class="lede">{@content.lede}</p>

            <ul :if={@steps != []} class="checks">
              <li :for={{bold, rest} <- @steps}>
                <.check class="check" />
                <div>
                  <p :if={bold} class="check-name">{bold}</p>
                  <p class={if(bold, do: "check-detail", else: "check-name")}>
                    {step_detail(rest)}
                  </p>
                </div>
              </li>
            </ul>

            <ul :if={@highlights != []} class="highlights">
              <li :for={highlight <- @highlights}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#5EEAD4" d="M13 2 4 14h7l-1 8 9-12h-7l1-8z" />
                </svg>
                {highlight}
              </li>
            </ul>
          </div>
        </div>

        <div :if={@content.closing not in [nil, ""]} class="band">{@content.closing}</div>

        <div class="offer">
          <div class="offer-row">
            <div class="qr-card">{Phoenix.HTML.raw(sheet.qr)}</div>
            <div>
              <p class="scan-lead">Point your camera here</p>
              <p class="scan-url">{@display_url}</p>
              <p :if={@content.terms not in [nil, ""]} class="scan-terms">{@content.terms}</p>
            </div>
          </div>

          <p class="foot">
            <span>{@content.footer}</span>
            <span class="code">{sheet.placement.code}</span>
          </p>
        </div>
      </div>
    </section>
  </body>
</html>
