# Copy to /apps/cold-forge/deploy/.env on the server and fill in. Never commit a
# filled-in copy; this template is the only version that belongs in git.

# ── Core ────────────────────────────────────────────────────────────────────
PHX_SERVER=true
# Appears in every tracked link, unsubscribe and survey URL inside outgoing
# mail, so it outlives any single deploy. Getting it wrong means dead links in
# inboxes you cannot reach.
PHX_HOST=go.affordablestartup.com
PORT=4000
# (new) mix phx.gen.secret
SECRET_KEY_BASE=
# Same host as the other apps on the box.
# (new database) docker exec -it global_postgres psql -U postgres -c "CREATE DATABASE cold_forge_prod;"
DATABASE_URL=ecto://postgres:CHANGE_ME@global_postgres:5432/cold_forge_prod
POOL_SIZE=10
ECTO_IPV6=false

# Where uploaded logos live. Matches the volume mount in docker-compose.yml —
# change one and you change both, or the logos land inside the container and
# disappear on the next deploy.
UPLOADS_DIR=/app/uploads

# ── Inbound replies ─────────────────────────────────────────────────────────
# The secret in the webhook path, /inbound/<token>. Without it that endpoint
# refuses everything — it fails closed, so replies simply stop being detected
# rather than the door standing open. (new) openssl rand -hex 32
INBOUND_TOKEN=

# ── Email — SES ─────────────────────────────────────────────────────────────
# Can reuse ExteriorPro's SES account and IAM user; the identity being verified
# is the sending domain, and this one is different. The IAM user needs only
# ses:SendRawEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
